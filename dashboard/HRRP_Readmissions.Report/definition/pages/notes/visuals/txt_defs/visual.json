                      "fontSize": "10pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Penalty flag: official CMS indicator; Y when eligible discharges >= 25 and ERR > peer-group median ERR.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Payment reduction %: FY 2026 HRRP reduction to base operating DRG payments (official, 0-3%).",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Payment-reduction points: each hospital's official reduction split across measures with the CMS formula (DRG ratio x (ERR - peer median) x neutrality modifier). Percentage points, not dollars.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Est. excess readmissions: readmissions x (1 - 1/ERR) where ERR > 1. A derived estimate, not a CMS count; rows with suppressed counts (mostly small hospitals) are excluded.",
