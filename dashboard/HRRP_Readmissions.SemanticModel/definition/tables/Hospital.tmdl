table Hospital
	lineageTag: 95c95636-1c1f-5c94-b448-e00ba6cc79ea

	/// HRRP hospitals in the current filter.
	measure Hospitals = COUNTROWS ( Hospital )
		formatString: #,0
		lineageTag: 8070773e-ebd4-5ac6-b301-21cbf827d905

	/// Hospitals in the FY 2026 HRRP Supplemental File (Maryland excluded by CMS).
	measure 'Hospitals with Payment Factor' = CALCULATE ( COUNTROWS ( Hospital ), Hospital[Has Payment Factor] = "Yes" )
		formatString: #,0
		lineageTag: d207c481-4aea-5b14-9c7b-ea392caa3349

	/// Share of hospitals with an official payment adjustment factor below 1.0000.
	measure '% Hospitals with Payment Reduction' = DIVIDE ( CALCULATE ( COUNTROWS ( Hospital ), Hospital[Payment Reduced] = "Yes" ), [Hospitals with Payment Factor] )
		formatString: 0.0%
		lineageTag: 911f0b1b-61d4-5b5b-b5c6-760a89780dd8

	/// Average FY 2026 HRRP reduction to base operating DRG payments (0-3%).
	measure 'Mean Payment Reduction %' = AVERAGE ( Hospital[Payment Reduction %] )
		formatString: 0.00"%"
		lineageTag: 1c1050ff-d8cb-51ce-88c1-c6bb64a6ce3c

	/// Median FY 2026 HRRP payment reduction.
	measure 'Median Payment Reduction %' = MEDIAN ( Hospital[Payment Reduction %] )
		formatString: 0.00"%"
		lineageTag: 1503450e-9950-5153-a301-ba86b21350a2

	/// Hospitals at the maximum 3% reduction.
	measure 'Hospitals at 3% Cap' = CALCULATE ( COUNTROWS ( Hospital ), Hospital[Payment Reduction %] >= 3 )
		formatString: #,0
		lineageTag: 0baa40f1-3288-533d-b6c7-964a513e160a

	/// Number of the six measures with penalty indicator = Y (single hospital).
	measure 'Hospital Measures Flagged' = MAX ( Hospital[Measures Flagged] )
		formatString: 0
		lineageTag: fc8697a5-62d5-5945-8f89-560fa6d0aa64

	/// Dense rank of the hospital's payment reduction within its state (1 = largest reduction).
	measure 'Rank in State' = ```
			VAR st = SELECTEDVALUE ( Hospital[State] )
			VAR cur = MAX ( Hospital[Payment Reduction %] )
			RETURN IF ( HASONEVALUE ( Hospital[Facility ID] ) && NOT ISBLANK ( cur ),
			    RANKX ( FILTER ( ALL ( Hospital ), Hospital[State] = st && NOT ISBLANK ( Hospital[Payment Reduction %] ) ),
			            Hospital[Payment Reduction %], cur, DESC, DENSE ) )
			```
		formatString: 0
		lineageTag: 153cad12-da7f-5f01-9587-2ca40c4898dd

