	partition ReadmissionFact = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\readmission_fact.csv"), [Delimiter = ",", Columns = 16, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Facility ID", type text}, {"Measure Code", type text}, {"Period Start", type date}, {"Period End", type date}, {"Reporting Period", type text}, {"Record Status", type text}, {"ERR", type number}, {"Predicted Rate", type number}, {"Expected Rate", type number}, {"Discharges", Int64.Type}, {"Eligible Discharges", Int64.Type}, {"Readmissions", Int64.Type}, {"Peer Median ERR", type number}, {"Penalty Indicator", type text}, {"Payment Reduction Points", type number}, {"Est Excess Readmissions", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
