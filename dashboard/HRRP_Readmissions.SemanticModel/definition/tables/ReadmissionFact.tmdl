		summarizeBy: none
		sourceColumn: Peer Median ERR

		annotation SummarizationSetBy = Automatic

	column 'Penalty Indicator'
		dataType: string
		lineageTag: fa62dca7-2380-5a9c-b0c7-de08a39c3b2c
		summarizeBy: none
		sourceColumn: Penalty Indicator

		annotation SummarizationSetBy = Automatic

	column 'Payment Reduction Points'
		dataType: double
