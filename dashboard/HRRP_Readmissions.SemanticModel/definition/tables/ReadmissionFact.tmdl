		summarizeBy: none
		sourceColumn: Payment Reduction Points

		annotation SummarizationSetBy = Automatic

	column 'Est Excess Readmissions'
		dataType: double
		formatString: #,0.0
		lineageTag: 6f532739-9126-519a-9816-40cc012c32db
