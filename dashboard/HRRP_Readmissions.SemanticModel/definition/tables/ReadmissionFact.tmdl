		formatString: 0.00
		lineageTag: 1fdf4880-c851-55d1-9d17-1f7c50df32a3
		summarizeBy: none
		sourceColumn: Predicted Rate

		annotation SummarizationSetBy = Automatic

	column 'Expected Rate'
		dataType: double
		formatString: 0.00
		lineageTag: 28e1a236-fabf-5d3b-8491-57b6ac6b1a6c
