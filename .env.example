# Copy to .env ONLY if you cannot use Windows Credential Manager. .env is git-ignored.
# Preferred: run scripts/install_oracle_free.ps1, which sets ORACLE_USER / ORACLE_DSN as
# user environment variables and stores the password in Credential Manager (keyring).
ORACLE_USER=HRRA
ORACLE_DSN=localhost:1521/FREEPDB1
# ORACLE_PASSWORD=   <- leave unset to use keyring service "hrra_oracle"
